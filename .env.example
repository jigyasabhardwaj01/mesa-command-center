# ============================================================
# MESA Command Center: environment variables
# Copy to .env, fill in, then: chmod 600 .env
# NEVER commit .env and NEVER paste these values into a chat.
# ============================================================

# ---------- 1. MESA NEXUS (required) ----------
NEXUS_BASE_URL=https://students.mesaschool.co.in
NEXUS_LOGIN_URL=https://students.mesaschool.co.in/login
NEXUS_USERNAME=your_nexus_email
NEXUS_PASSWORD=your_nexus_password
NEXUS_AUTH_MODE=storage_state
NEXUS_STORAGE_STATE_PATH=./.auth/nexus-state.json       # saved browser session (gitignored)

# Filled in only if discovery finds them (leave blank otherwise)
NEXUS_API_TOKEN=
NEXUS_API_BASE=https://api-students.mesaschool.co.in/api/v1
NEXUS_ICAL_URL=
NEXUS_RSS_URL=

# Polite-scraping controls
NEXUS_REQUEST_DELAY_MS=1500
SYNC_INTERVAL_MINUTES=30
NEXUS_READ_ONLY=true                                    # hard guard: block any POST that isn't login

# ---------- 2. AI ----------
# Provider-neutral. Pick ONE primary provider; claude-cli is the automatic fallback.
LLM_PROVIDER=gemini                                     # gemini | anthropic | claude-cli
LLM_FALLBACK_PROVIDER=claude-cli                        # used when the primary is rate-limited (429) for too long, or "none"

# Gemini (event/free-tier key). Use ONLY the one key the organizers assigned to your team.
# Free-tier limits are counted per key, so do not rotate through other teams' keys.
GEMINI_API_KEY=PASTE_YOUR_TEAMS_KEY_HERE
GEMINI_MODEL_FAST=                                      # leave blank; Claude Code lists available models and fills these
GEMINI_MODEL_SMART=

# Anthropic (only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_SMART=claude-sonnet-4-5

# Free-tier friendliness
LLM_MAX_CONCURRENCY=1                                   # one AI call at a time
LLM_MAX_REQUESTS_PER_MINUTE=10                          # set to your key's real limit once known
LLM_DAILY_REQUEST_BUDGET=300                            # hard stop per day; the dashboard shows usage
LLM_RETRY_MAX=6                                         # exponential backoff with jitter on 429/5xx

AI_POLICY_MODE=check_per_assignment                     # check_per_assignment | allowed | outline_only

# ---------- 3. PLANNING RULES ----------
TIMEZONE=Asia/Kolkata
DRAFT_BUFFER_DAYS=3                                     # first draft ready this many days before deadline (min 2)
HOURS_PER_WEEKDAY=3                                     # realistic study hours on a normal weekday
HOURS_PER_WEEKEND_DAY=5
MAX_PARALLEL_ASSIGNMENTS=3
QUIET_HOURS=23:00-07:00                                 # no alerts, no scheduled work blocks

# ---------- 4. STORAGE ----------
DATABASE_URL=file:./data/command-center.db
DOCUMENTS_DIR=./data/documents
WRITING_SAMPLES_DIR=./config/my-writing

# ---------- 5. DASHBOARD ----------
DASHBOARD_PORT=3000
DASHBOARD_HOST=127.0.0.1                                # keep local-only
APP_SECRET=generate-with-openssl-rand-hex-32

# ---------- 6. OPTIONAL: GOOGLE CALENDAR / GMAIL ----------
# Lets the plan write blocks to a dedicated "Nexus Plan" calendar and
# read Nexus notification emails. Skip if you don't want it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_PLAN_CALENDAR_NAME=Nexus Plan
GMAIL_NOTICE_SENDERS=                                   # comma-separated addresses Nexus emails you from

# ---------- 7. OPTIONAL: PHONE ALERTS ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                                             # pick a long random topic name; install the ntfy app
ALERT_ON=deadline_changed,new_assignment,start_now,at_risk
